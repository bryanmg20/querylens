# Variables de docker-compose.yml. Copiar a .env y llenar, o generar uno con
# secretos aleatorios:
#
#   python3 scripts/gen_env.py > .env
#
# El .env real no se versiona (.gitignore).

# --- Obligatorias (compose falla con "falta en .env" si no estan) ---

# Superusuario de la base de QueryLens (servicio postgres). Solo lo usan
# db-roles y los tests; cada servicio entra con su propio rol.
QUERYLENS_USER=ql_user
QUERYLENS_PASSWORD=
QUERYLENS_DB=ql_demo

# Contrasenas de los roles por servicio (querylens_database/service_roles.sql).
# db-roles las aplica en cada up: cambiarlas aqui basta.
QL_AUTH_DB_PASSWORD=
QL_API_DB_PASSWORD=
QL_PIPELINE_DB_PASSWORD=
QL_DETECTOR_DB_PASSWORD=

# Clave Fernet con la que auth-service cifra las contrasenas de las bases
# registradas y el pipeline las descifra. Cambiarla con un volumen existente
# deja ilegibles las ya guardadas.
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AUTH_ENCRYPTION_KEY=

# Firma de los JWT (auth-service los emite, api-rest los valida).
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# --- Opcionales (valor por defecto entre parentesis) ---

# Puerto de nginx en 127.0.0.1 (8080).
# NGINX_PORT=8080
# Duracion del JWT en minutos (480).
# JWT_EXPIRE_MINUTES=480
# Origenes CORS separados por coma; vacio porque el front va por nginx ().
# CORS_ORIGINS=
# Prefijos que el bundle del frontend usa para las APIs (/auth y /api). Se
# fijan en el build: al cambiarlos, docker compose build frontend.
# NEXT_PUBLIC_AUTH_SERVICE_URL=/auth
# NEXT_PUBLIC_API_REST_URL=/api
# Pipeline: intervalo de extraccion (10), nivel de log (INFO) y salud
# (300 / 3600 / 15).
# EXTRACT_INTERVAL_S=10
# QL_LOG_LEVEL=INFO
# HEALTH_PREFLIGHT_TTL_S=300
# HEALTH_PURGE_INTERVAL_S=3600
# HEALTH_RETENTION_DAYS=15
# Servicio tests: base propia (ql_test) y uid/gid del dueno del repo (1000).
# En Linux con otro uid, poner los de "id -u" / "id -g" (gen_env.py ya lo
# hace): si no, los tests no pueden escribir sus logs en el repo montado.
# QL_TEST_DB=ql_test
# HOST_UID=1000
# HOST_GID=1000
